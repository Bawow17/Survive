		<Item class="ModuleScript" referent="RBXBE2E01C4FA4A459A99D56422805AC7B8">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- Central shard inventory store shared by shard collection and forge systems.
-- Keeps per-player shard counts keyed by template name and rarity.
-- Provides helpers to query/consume shards by rarity and to build sync payloads.
local ShardInventoryService = {}

local inventories = {}

local function humanizeCaps(str)
    str = tostring(str or "")
    local out = {}
    for i = 1, #str do
        local ch = string.sub(str, i, i)
        local prev = i > 1 and string.sub(str, i - 1, i - 1) or ""
        if i > 1 and ch:match("%u") and prev:match("[%l%d]") then
            table.insert(out, " ")
        end
        table.insert(out, ch)
    end
    return table.concat(out)
end

local function getDisplayName(templateName, rarity)
    if rarity and rarity ~= "" then
        return string.format("%s Shard", humanizeCaps(rarity))
    end
    if not templateName or templateName == "" then
        return "Shard"
    end
    local cleaned = string.gsub(templateName, "LightShard", "Shard")
    cleaned = string.gsub(cleaned, "Light", " ")
    return humanizeCaps(cleaned)
end

local function ensurePlayerInv(player)
    if not player then
        return nil
    end
    inventories[player] = inventories[player] or {}
    return inventories[player]
end

function ShardInventoryService.InitPlayer(player)
    ensurePlayerInv(player)
end

function ShardInventoryService.ClearPlayer(player)
    inventories[player] = nil
end

function ShardInventoryService.AddShard(player, templateName, rarity)
    if not player or not templateName or templateName == "" then
        return
    end
    local inv = ensurePlayerInv(player)
    local entry = inv[templateName]
    if not entry then
        entry = {
            count = 0,
            rarity = rarity or "Shard",
            displayName = getDisplayName(templateName, rarity),
        }
        inv[templateName] = entry
    end
    entry.count += 1
    return entry.count
end

-- Returns true if shards were successfully consumed.
function ShardInventoryService.ConsumeByRarity(player, rarity, amount)
    rarity = rarity or "Shard"
    amount = math.max(0, tonumber(amount) or 0)
    if amount <= 0 then
        return true
    end
    local inv = inventories[player]
    if not inv then
        return false
    end

    local remaining = amount
    for templateName, entry in pairs(inv) do
        if entry and string.lower(entry.rarity or "") == string.lower(rarity) then
            local take = math.min(entry.count or 0, remaining)
            entry.count -= take
            remaining -= take
            if entry.count <= 0 then
                inv[templateName] = nil
            end
            if remaining <= 0 then
                break
            end
        end
    end

    return remaining <= 0
end

function ShardInventoryService.GetCountByRarity(player, rarity)
    rarity = rarity or "Shard"
    local inv = inventories[player]
    if not inv then
        return 0
    end
    local total = 0
    for _, entry in pairs(inv) do
        if entry and string.lower(entry.rarity or "") == string.lower(rarity) then
            total += entry.count or 0
        end
    end
    return total
end

function ShardInventoryService.GetInventory(player)
    return inventories[player] or {}
end

function ShardInventoryService.BuildPayload(player)
    local inv = inventories[player] or {}
    local payload = {}
    for templateName, entry in pairs(inv) do
        table.insert(payload, {
            templateName = templateName,
            count = entry.count or 0,
            rarity = entry.rarity or "Shard",
            displayName = entry.displayName or getDisplayName(templateName, entry.rarity),
        })
    end
    return payload
end

local syncEvent

function ShardInventoryService.SetSyncEvent(event)
    syncEvent = event
end

function ShardInventoryService.SendInventory(player)
    if syncEvent and player then
        syncEvent:FireClient(player, ShardInventoryService.BuildPayload(player))
    end
end

return ShardInventoryService
]]></ProtectedString>
