			<Item class="LocalScript" referent="RBX887B7814ED4843CEB5D760C7FAA7AF15">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local INVENTORY_REMOTE_FOLDER = "InventoryRemotes"
local INVENTORY_SYNC_EVENT = "InventorySync"

local FORGE_REMOTE_FOLDER = "ForgeRemotes"
local FORGE_REQUEST_NAME = "RequestForge"
local FORGE_RESULT_EVENT = "ForgeResult"

local remotes = ReplicatedStorage:WaitForChild(INVENTORY_REMOTE_FOLDER)
local syncEvent = remotes:WaitForChild(INVENTORY_SYNC_EVENT)

local forgeRemotes = ReplicatedStorage:WaitForChild(FORGE_REMOTE_FOLDER)
local requestForge = forgeRemotes:WaitForChild(FORGE_REQUEST_NAME)
local forgeResultEvent = forgeRemotes:WaitForChild(FORGE_RESULT_EVENT)

local recipes = {
    CommonVessel = { rarity = "Common", amount = 1 },
    UncommonVessel = { rarity = "Uncommon", amount = 5 },
    RareVessel = { rarity = "Rare", amount = 3 },
    EpicVessel = { rarity = "Epic", amount = 2 },
    LegendaryVessel = { rarity = "Legendary", amount = 1 },
    MythicalVessel = { rarity = "Mythical", amount = 1 },
}

local activeConnections = {}
local retrying = false
local lastInventoryData
local toggleRef
local panelRef
local listRef

local function disconnectAll()
    for _, conn in ipairs(activeConnections) do
        if conn and conn.Connected then
            conn:Disconnect()
        end
    end
    table.clear(activeConnections)
end

local function waitForDescendant(parent, name, timeout)
    local elapsed = 0
    while parent and parent.Parent and elapsed < (timeout or 5) do
        local found = parent:FindFirstChild(name, true)
        if found then
            return found
        end
        task.wait(0.1)
        elapsed += 0.1
    end
    return nil
end

local function closeOtherPanels()
    local screen = playerGui:FindFirstChild("IngameScreenGui")
    if not screen then
        return
    end
    local invPanel = screen:FindFirstChild("InventoryPanel", true)
    if invPanel then
        invPanel.Visible = false
    end
    local starsPanel = screen:FindFirstChild("StarsPanel", true)
    if starsPanel then
        starsPanel.Visible = false
    end
end

local function setPanelVisible(open)
    if not panelRef then
        return
    end
    panelRef.Visible = open
    if open then
        closeOtherPanels()
    end
end

local function craft(playerRecipeKey)
    if not playerRecipeKey then
        return
    end
    local success, result = pcall(function()
        return requestForge:InvokeServer(playerRecipeKey)
    end)
    if not success then
        warn("[ForgeToggle] Forge request failed:", result)
        return
    end
    if not result or not result.ok then
        if result and result.message then
            warn("[ForgeToggle]", result.message)
        end
    end
end

local function updateRecipeRow(row, recipe, shardCount)
    if not row or not recipe then
        return
    end
    local frame = row:FindFirstChild("Frame")
    local label = frame and frame:FindFirstChild("RecipeTextLabel")
    local button = frame and frame:FindFirstChild("CraftTextButton")

    local needed = recipe.amount or 0
    local have = shardCount or 0
    local shardWord = needed == 1 and "Shard" or "Shards"
    if label and label:IsA("TextLabel") then
        label.Text = string.format("%d/%d %s %s", have, needed, recipe.rarity, shardWord)
        label.TextColor3 = have >= needed and Color3.fromRGB(63, 255, 81) or Color3.fromRGB(255, 84, 84)
    end
    if button and button:IsA("TextButton") then
        button.Active = have >= needed
        button.AutoButtonColor = have >= needed
        button.BackgroundTransparency = have >= needed and 0.5 or 0.8
    end
end

local function computeRarityCounts(data)
    local counts = {}
    if type(data) ~= "table" then
        return counts
    end
    for _, entry in ipairs(data) do
        if entry and entry.rarity then
            local key = tostring(entry.rarity)
            counts[key] = (counts[key] or 0) + (entry.count or 0)
        end
    end
    return counts
end

local function refreshUIWithInventory(data)
    if not listRef then
        return
    end
    local counts = computeRarityCounts(data)
    for recipeKey, recipe in pairs(recipes) do
        local row = listRef:FindFirstChild(recipeKey)
        updateRecipeRow(row, recipe, counts[recipe.rarity] or 0)
    end
end

local function bindCraftButtons()
    if not listRef then
        return
    end
    for recipeKey in pairs(recipes) do
        local row = listRef:FindFirstChild(recipeKey)
        local frame = row and row:FindFirstChild("Frame")
        local button = frame and frame:FindFirstChild("CraftTextButton")
        if button and button:IsA("TextButton") then
            local conn = button.Activated:Connect(function()
                craft(recipeKey)
            end)
            table.insert(activeConnections, conn)
        end
    end
end

local function connectToggle()
    disconnectAll()

    local screenGui = playerGui:FindFirstChild("IngameScreenGui") or playerGui:WaitForChild("IngameScreenGui", 2)
    if not screenGui then
        if not retrying then
            retrying = true
            task.delay(1, function()
                retrying = false
                connectToggle()
            end)
        end
        return
    end

    toggleRef = waitForDescendant(screenGui, "ForgeToggle", 2)
    panelRef = waitForDescendant(screenGui, "ForgePanel", 2)
    listRef = panelRef and waitForDescendant(panelRef, "CraftingListStars", 2)

    if not toggleRef or not panelRef or not listRef then
        if not retrying then
            retrying = true
            task.delay(1, function()
                retrying = false
                connectToggle()
            end)
        end
        return
    end

    local function setOpen(open)
        setPanelVisible(open)
        if open and lastInventoryData then
            refreshUIWithInventory(lastInventoryData)
        end
    end

    local conn = toggleRef.Activated:Connect(function()
        setOpen(not panelRef.Visible)
    end)
    table.insert(activeConnections, conn)

    for _, descendant in ipairs(panelRef:GetDescendants()) do
        if descendant:IsA("GuiButton") then
            local lowerName = string.lower(descendant.Name or "")
            local text = (descendant:IsA("TextButton") or descendant:IsA("ImageButton")) and (descendant.Text or "")
            local lowerText = string.lower(text or "")
            local isClose = lowerName:find("close") or lowerName == "x" or lowerText == "x" or lowerText:find("close")
            if isClose then
                local c = descendant.Activated:Connect(function()
                    setOpen(false)
                end)
                table.insert(activeConnections, c)
            end
        end
    end

    bindCraftButtons()
    if lastInventoryData then
        refreshUIWithInventory(lastInventoryData)
    end
end

connectToggle()

syncEvent.OnClientEvent:Connect(function(data)
    lastInventoryData = data
    refreshUIWithInventory(lastInventoryData)
end)

forgeResultEvent.OnClientEvent:Connect(function(result)
    if not result or result.ok then
        return
    end
    if result.message then
        warn("[ForgeToggle]", result.message)
    end
end)

playerGui.ChildAdded:Connect(function(child)
    if child.Name == "IngameScreenGui" then
        task.defer(connectToggle)
    end
end)

player.CharacterAdded:Connect(function()
    task.defer(connectToggle)
end)

player.CharacterRemoving:Connect(function()
    disconnectAll()
end)

return {
    closePanel = function()
        local screen = playerGui:FindFirstChild("IngameScreenGui")
        if not screen then
            return
        end
        local panel = waitForDescendant(screen, "ForgePanel", 0.1)
        if panel then
            panel.Visible = false
        end
    end,
}
]]></ProtectedString>
