				<Item class="LocalScript" referent="RBX306BEBBA5DD84973813BC9BAC4D0E0E0">
					<Properties>
						<ProtectedString name="Source"><![CDATA[-- LocalScript under your ScrollingFrame
local scroller = script.Parent
local layout = scroller:WaitForChild("UIGridLayout") -- or UIGridLayout (see note below)

local MAX_VISIBLE = 6          -- max rows visible at once
local MIN_ROW_HEIGHT = 28      -- optional clamp
local MAX_ROW_HEIGHT = 120     -- optional clamp
local PADDING = 6              -- match your layout padding (pixels)

local function isRow(gui)
	return gui:IsA("Frame") or gui:IsA("TextButton") or gui:IsA("ImageButton")
end

local function getRows()
	local rows = {}
	for _, child in ipairs(scroller:GetChildren()) do
		if isRow(child) then
			table.insert(rows, child)
		end
	end
	return rows
end

local function relayout()
	local rows = getRows()
	local count = #rows
	local visibleCount = math.max(1, math.min(count, MAX_VISIBLE))

	local totalPaddingVisible = PADDING * math.max(0, visibleCount - 1)
	local available = math.max(0, scroller.AbsoluteSize.Y - totalPaddingVisible)
	local rowH = math.floor(available / visibleCount)
	rowH = math.clamp(rowH, MIN_ROW_HEIGHT, MAX_ROW_HEIGHT)

	for _, row in ipairs(rows) do
		row.Size = UDim2.new(1, 0, 0, rowH)
	end

	local totalPaddingAll = PADDING * math.max(0, count - 1)
	local canvasH = count * rowH + totalPaddingAll
	scroller.CanvasSize = UDim2.fromOffset(0, canvasH)
end

-- Ensure scroll behavior
scroller.AutomaticCanvasSize = Enum.AutomaticSize.None
scroller.ScrollingDirection = Enum.ScrollingDirection.Y

-- Keep padding in sync with your layout
if layout:IsA("UIListLayout") then
	layout.Padding = UDim.new(0, PADDING)
elseif layout:IsA("UIGridLayout") then
	layout.CellPadding = UDim2.fromOffset(0, PADDING)
end

scroller.ChildAdded:Connect(relayout)
scroller.ChildRemoved:Connect(relayout)
scroller:GetPropertyChangedSignal("AbsoluteSize"):Connect(relayout)

if layout:IsA("UIListLayout") then
	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(relayout)
end

relayout()
]]></ProtectedString>
