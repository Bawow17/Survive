				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">ForgeSystem</string>
				<int64 name="SourceAssetId">-1</int64>
				<BinaryString name="Tags"></BinaryString>
				<UniqueId name="UniqueId">4ae555d950b89c570941cf0a00004071</UniqueId>
			</Properties>
		</Item>
		<Item class="Script" referent="RBXCACE6D0EFBD040EEBF903C15A3DB6B28">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local REMOTE_FOLDER_NAME = "VesselRemotes"
local USE_FUNCTION_NAME = "UseVessel"
local RESULT_EVENT_NAME = "VesselResult"

local remotes = ReplicatedStorage:FindFirstChild(REMOTE_FOLDER_NAME)
if not remotes then
    remotes = Instance.new("Folder")
    remotes.Name = REMOTE_FOLDER_NAME
    remotes.Parent = ReplicatedStorage
end

local useFn = remotes:FindFirstChild(USE_FUNCTION_NAME)
if not useFn then
    useFn = Instance.new("RemoteFunction")
    useFn.Name = USE_FUNCTION_NAME
    useFn.Parent = remotes
end

local resultEvent = remotes:FindFirstChild(RESULT_EVENT_NAME)
if not resultEvent then
    resultEvent = Instance.new("RemoteEvent")
    resultEvent.Name = RESULT_EVENT_NAME
    resultEvent.Parent = remotes
end

local COMMON_STARS = { "Flame", "Water", "Nature" }
local STAR_REMOTE_FOLDER = "StarSystemRemotes"
local GRANT_STAR_EVENT_NAME = "GrantStar"

local starRemotes = ReplicatedStorage:FindFirstChild(STAR_REMOTE_FOLDER)
local grantStarEvent = starRemotes and starRemotes:FindFirstChild(GRANT_STAR_EVENT_NAME)
local rng = Random.new()

local function destroyTool(tool)
    if tool and tool.Parent then
        tool:Destroy()
    end
end

local function pickRandomCommon()
    local idx = rng:NextInteger(1, #COMMON_STARS)
    return COMMON_STARS[idx]
end

local function inferRarityFromName(name)
    name = string.lower(tostring(name or ""))
    if string.find(name, "common") then
        return "Common"
    elseif string.find(name, "uncommon") then
        return "Uncommon"
    elseif string.find(name, "rare") then
        return "Rare"
    elseif string.find(name, "epic") then
        return "Epic"
    elseif string.find(name, "legendary") then
        return "Legendary"
    elseif string.find(name, "mythical") then
        return "Mythical"
    end
    return ""
end

local function grantCommonStar(player)
    local starType = pickRandomCommon()
    local api = _G.StarSystemApi
    if api and api.AddStar then
        api.AddStar(player, starType)
        return true, starType
    end
    -- Fallback to remote event if API not yet ready.
    if not grantStarEvent then
        starRemotes = starRemotes or ReplicatedStorage:FindFirstChild(STAR_REMOTE_FOLDER)
        grantStarEvent = starRemotes and starRemotes:FindFirstChild(GRANT_STAR_EVENT_NAME)
    end
    if grantStarEvent then
        grantStarEvent:Fire(player, starType)
        return true, starType
    end
    return false, starType
end

local function isHoldingTool(player, tool)
    if not player or not tool then
        return false
    end
    local character = player.Character
    local backpack = player:FindFirstChildOfClass("Backpack")
    if tool.Parent == character or tool.Parent == backpack then
        return true
    end
    return false
end

useFn.OnServerInvoke = function(player, tool)
    if typeof(tool) ~= "Instance" or not tool:IsA("Tool") then
        warn("[VesselUse] invalid tool from", player and player.Name)
        return { ok = false, message = "Invalid tool" }
    end
    if not isHoldingTool(player, tool) then
        warn("[VesselUse] tool not held by", player and player.Name, tool.Name)
        return { ok = false, message = "Tool not held" }
    end

    local rarity = tostring(tool:GetAttribute("VesselRarity") or inferRarityFromName(tool.Name))
    local templateName = tostring(tool:GetAttribute("VesselTemplate") or tool.Name)
    warn("[VesselUse] invoked by", player.Name, "rarity", rarity, "template", templateName)

    if rarity:lower() == "common" then
        local granted, starType = grantCommonStar(player)
        if granted and starType then
            destroyTool(tool)
            local msg = string.format("You have gained a %s!", string.lower(starType) .. " star")
            resultEvent:FireClient(player, {
                ok = true,
                starType = starType,
                message = msg,
            })
            return { ok = true, starType = starType, message = msg }
        end
        return { ok = false, message = "Failed to grant star" }
    end

    -- Other vessels: consume without reward for now.
    destroyTool(tool)
    resultEvent:FireClient(player, {
        ok = true,
        starType = nil,
        message = string.format("%s used.", templateName),
    })
    return { ok = true }
end
