		<Item class="Script" referent="RBX54E0EBBB5BC94D4CB1A6B3C743D48E4F">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ShardInventoryService = require(script.Parent:WaitForChild("ShardInventoryService"))

local REMOTE_FOLDER_NAME = "ForgeRemotes"
local REQUEST_NAME = "RequestForge"
local RESULT_EVENT_NAME = "ForgeResult"

local remotes = ReplicatedStorage:FindFirstChild(REMOTE_FOLDER_NAME)
if not remotes then
    remotes = Instance.new("Folder")
    remotes.Name = REMOTE_FOLDER_NAME
    remotes.Parent = ReplicatedStorage
end

local requestFn = remotes:FindFirstChild(REQUEST_NAME)
if not requestFn then
    requestFn = Instance.new("RemoteFunction")
    requestFn.Name = REQUEST_NAME
    requestFn.Parent = remotes
end

local resultEvent = remotes:FindFirstChild(RESULT_EVENT_NAME)
if not resultEvent then
    resultEvent = Instance.new("RemoteEvent")
    resultEvent.Name = RESULT_EVENT_NAME
    resultEvent.Parent = remotes
end

local craftablesFolder = ServerStorage:FindFirstChild("Craftables")
local vesselFolder = craftablesFolder and craftablesFolder:FindFirstChild("Vessels")

local recipes = {
    CommonVessel = { costRarity = "Common", costAmount = 1 },
    UncommonVessel = { costRarity = "Uncommon", costAmount = 5 },
    RareVessel = { costRarity = "Rare", costAmount = 3 },
    EpicVessel = { costRarity = "Epic", costAmount = 2 },
    LegendaryVessel = { costRarity = "Legendary", costAmount = 1 },
    MythicalVessel = { costRarity = "Mythical", costAmount = 1 },
}

local function inferRarityFromName(name)
    name = string.lower(tostring(name or ""))
    if string.find(name, "common") then
        return "Common"
    elseif string.find(name, "uncommon") then
        return "Uncommon"
    elseif string.find(name, "rare") then
        return "Rare"
    elseif string.find(name, "epic") then
        return "Epic"
    elseif string.find(name, "legendary") then
        return "Legendary"
    elseif string.find(name, "mythical") then
        return "Mythical"
    end
    return ""
end

local function humanizeCaps(str)
    str = tostring(str or "")
    local out = {}
    for i = 1, #str do
        local ch = string.sub(str, i, i)
        local prev = i > 1 and string.sub(str, i - 1, i - 1) or ""
        if i > 1 and ch:match("%u") and prev:match("[%l%d]") then
            table.insert(out, " ")
        end
        table.insert(out, ch)
    end
    return table.concat(out)
end

local function getVesselTemplate(name)
    craftablesFolder = craftablesFolder or ServerStorage:FindFirstChild("Craftables")
    vesselFolder = vesselFolder or (craftablesFolder and craftablesFolder:FindFirstChild("Vessels"))
    if not vesselFolder then
        return nil
    end
    return vesselFolder:FindFirstChild(name)
end

local function buildToolFromTemplate(template)
    local tool = Instance.new("Tool")
    tool.Name = humanizeCaps(template.Name)
    tool.CanBeDropped = true
    tool.RequiresHandle = false
    -- Offset the model 0.5 studs in the opposite direction from current (positive Z here).
    tool.Grip = CFrame.new(0, 0, 0.5)

    local clone = template:Clone()
    local primary = clone:FindFirstChild("Handle") or clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart")

    -- Collect all parts/instances before reparenting to preserve everything.
    local descendants = clone:GetDescendants()
    for _, child in ipairs(clone:GetChildren()) do
        table.insert(descendants, child)
    end

    if primary then
        primary.Name = "Handle"
        tool.RequiresHandle = true

        -- Reparent everything into the tool and weld parts to the handle.
        for _, inst in ipairs(descendants) do
            if inst == clone then
                continue
            end
            inst.Parent = tool
            if inst:IsA("BasePart") then
                inst.Anchored = false
                inst.CanCollide = false
                if inst ~= primary then
                    local weld = Instance.new("WeldConstraint")
                    weld.Part0 = primary
                    weld.Part1 = inst
                    weld.Parent = primary
                end
            end
        end
        primary.Parent = tool
        clone:Destroy()
    else
        clone.Parent = tool
    end

    tool:SetAttribute("VesselTemplate", template.Name)
    tool:SetAttribute("VesselRarity", inferRarityFromName(template.Name))

    return tool
end

local function giveVesselToPlayer(player, vesselName)
    local template = getVesselTemplate(vesselName)
    if not template then
        warn("[ForgeSystem]", player and player.Name or "?", "Template missing for", vesselName)
        return false, "Template missing"
    end

    local tool = buildToolFromTemplate(template)

    local backpack = player:FindFirstChildOfClass("Backpack") or player:FindFirstChild("Backpack")
    if not backpack then
        backpack = player:WaitForChild("Backpack", 5)
    end
    if backpack then
        tool.Parent = backpack
        warn("[ForgeSystem]", player.Name, "received", vesselName, "Tool in Backpack")
    else
        tool.Parent = player
        warn("[ForgeSystem]", player.Name, "received", vesselName, "Tool parented to player (no Backpack found)")
    end

    -- Also add to starter gear so it persists across respawns.
    local starterGear = player:FindFirstChild("StarterGear")
    if starterGear then
        local sgTool = buildToolFromTemplate(template)
        sgTool.Parent = starterGear
    end
    return true
end

local function formatShardRequirement(recipe)
    if not recipe then
        return ""
    end
    local shardText = recipe.costAmount == 1 and "Shard" or "Shards"
    return string.format("%d %s %s", recipe.costAmount, recipe.costRarity, shardText)
end

local function processForge(player, itemName)
    if not player or not itemName then
        return false, "Invalid request"
    end
    itemName = tostring(itemName)

    local recipe = recipes[itemName]
    if not recipe then
        return false, "Unknown recipe"
    end

    ShardInventoryService.InitPlayer(player)
    local have = ShardInventoryService.GetCountByRarity(player, recipe.costRarity)
    if have < recipe.costAmount then
        return false, string.format("Need %s", formatShardRequirement(recipe))
    end

    local consumed = ShardInventoryService.ConsumeByRarity(player, recipe.costRarity, recipe.costAmount)
    if not consumed then
        return false, "Not enough shards"
    end

    local ok, err = giveVesselToPlayer(player, itemName)
    if not ok then
        return false, err or "Failed to forge"
    end

    ShardInventoryService.SendInventory(player)
    return true, "Forged " .. itemName
end

requestFn.OnServerInvoke = function(player, itemName)
    local ok, message = processForge(player, itemName)
    resultEvent:FireClient(player, {
        ok = ok,
        message = message,
        item = itemName,
    })
    return {
        ok = ok,
        message = message,
    }
end

Players.PlayerRemoving:Connect(function(player)
    resultEvent:FireClient(player, {
        ok = false,
        message = "Player left",
        item = nil,
    })
end)
]]></ProtectedString>
