			<Item class="LocalScript" referent="RBX495461EE7A754BC78C6D54DA84BA4FD4">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local REMOTE_FOLDER_NAME = "VesselRemotes"
local USE_FUNCTION_NAME = "UseVessel"
local RESULT_EVENT_NAME = "VesselResult"

local remotes = ReplicatedStorage:WaitForChild(REMOTE_FOLDER_NAME)
local useFn = remotes:WaitForChild(USE_FUNCTION_NAME)
local resultEvent = remotes:WaitForChild(RESULT_EVENT_NAME)

local confirmPanel
local confirmButton
local declineButtons = {}
local messageTemplate
local screenGui

local currentTool = nil
local activeConnections = {}
local toolConnections = {}
local trackedTools = {}
local polling = false

local function disconnectAll()
    for _, conn in ipairs(activeConnections) do
        if conn and conn.Connected then
            conn:Disconnect()
        end
    end
    table.clear(activeConnections)
    for tool, conns in pairs(toolConnections) do
        for _, c in ipairs(conns) do
            if c and c.Connected then
                c:Disconnect()
            end
        end
    end
    toolConnections = {}
    trackedTools = {}
end

local function waitForDescendant(parent, name, timeout)
    local elapsed = 0
    while parent and parent.Parent and elapsed < (timeout or 5) do
        local found = parent:FindFirstChild(name, true)
        if found then
            return found
        end
        task.wait(0.1)
        elapsed += 0.1
    end
    return nil
end

local function findUi()
    screenGui = playerGui:FindFirstChild("IngameScreenGui")
        or playerGui:WaitForChild("IngameScreenGui", 5)
    if not screenGui then
        warn("[VesselUse] IngameScreenGui not found")
        return
    end
    confirmPanel = waitForDescendant(screenGui, "ConfirmPanel", 2)
    if not confirmPanel then
        warn("[VesselUse] ConfirmPanel not found")
    end
    confirmButton = confirmPanel and waitForDescendant(confirmPanel, "ConfirmTextButton", 1)
    if confirmPanel and not confirmButton then
        warn("[VesselUse] ConfirmTextButton not found")
    end
    declineButtons = {}
    if confirmPanel then
        for _, btn in ipairs(confirmPanel:GetDescendants()) do
            if btn:IsA("GuiButton") then
                local name = string.lower(btn.Name or "")
                local text = (btn:IsA("TextButton") or btn:IsA("ImageButton")) and string.lower(btn.Text or "") or ""
                if name:find("decline") or name:find("close") or name == "x" or text == "x" or text:find("decline") or text:find("close") then
                    table.insert(declineButtons, btn)
                end
            end
        end
    end
    messageTemplate = screenGui:FindFirstChild("MessageFrame", true)
    if messageTemplate then
        messageTemplate = messageTemplate:FindFirstChild("TextAlertExampleLabel", true)
        if messageTemplate then
            messageTemplate.Visible = false -- keep template hidden
        end
    else
        warn("[VesselUse] MessageFrame template not found")
    end
end

local function hideConfirm()
    if confirmPanel then
        confirmPanel.Visible = false
    end
    currentTool = nil
end

local function showConfirm(tool)
    if not confirmPanel then
        findUi()
    end
    if not confirmPanel then
        warn("[VesselUse] Cannot show confirm, panel missing")
        return
    end
    -- Close other panels when confirming.
    if screenGui then
        local invPanel = screenGui:FindFirstChild("InventoryPanel", true)
        local starsPanel = screenGui:FindFirstChild("StarsPanel", true)
        local forgePanel = screenGui:FindFirstChild("ForgePanel", true)
        if invPanel then invPanel.Visible = false end
        if starsPanel then starsPanel.Visible = false end
        if forgePanel then forgePanel.Visible = false end
    end
    currentTool = tool
    confirmPanel.Visible = true
    warn("[VesselUse] Showing confirm for tool", tool and tool.Name)
end

local function fadeMessage(text)
    if not messageTemplate or not messageTemplate.Parent then
        warn("[VesselUse] No message template available")
        return
    end
    local label = messageTemplate:Clone()
    label.Visible = true
    label.TextTransparency = 0
    label.Text = text or ""
    label.Parent = messageTemplate.Parent
    task.delay(5, function()
        if not label or not label.Parent then
            return
        end
        local tween = TweenService:Create(label, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { TextTransparency = 1 })
        tween:Play()
        tween.Completed:Connect(function()
            if label then
                label:Destroy()
            end
        end)
    end)
end

local function onConfirm()
    if not currentTool then
        warn("[VesselUse] Confirm with no current tool")
        hideConfirm()
        return
    end
    local success, result = pcall(function()
        return useFn:InvokeServer(currentTool)
    end)
    hideConfirm()
    if not success then
        warn("[VesselUse]", result)
        return
    end
    warn("[VesselUse] Server result", result and result.ok, result and result.message)
end

local function bindUi()
    disconnectAll()
    findUi()
    if confirmButton then
        table.insert(activeConnections, confirmButton.Activated:Connect(onConfirm))
    end
    for _, btn in ipairs(declineButtons) do
        local conn = btn.Activated:Connect(function()
            hideConfirm()
        end)
        table.insert(activeConnections, conn)
    end
end

local function isVessel(tool)
    if not tool or not tool:IsA("Tool") then
        return false
    end
    local templateAttr = tool:GetAttribute("VesselTemplate")
    local isMatch = templateAttr ~= nil or string.find(string.lower(tool.Name), "vessel") ~= nil
    if isMatch then
        warn("[VesselUse] Recognized vessel tool", tool.Name, "template:", templateAttr)
    end
    return isMatch
end

local function hookTool(tool)
    if not isVessel(tool) then
        return
    end
    if toolConnections[tool] then
        return
    end
    trackedTools[tool] = true
    warn("[VesselUse] Hooking tool", tool.Name)
    toolConnections[tool] = toolConnections[tool] or {}
    local conn = tool.Activated:Connect(function()
        warn("[VesselUse] Tool activated", tool.Name)
        showConfirm(tool)
    end)
    table.insert(toolConnections[tool], conn)
end

local function trackBackpack(backpack)
    if not backpack then
        return
    end
    warn("[VesselUse] Tracking backpack", backpack:GetFullName())
    for _, child in ipairs(backpack:GetChildren()) do
        if child:IsA("Tool") then
            hookTool(child)
        end
    end
    table.insert(activeConnections, backpack.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            hookTool(child)
        end
    end))
end

local function pollTools()
    if polling then
        return
    end
    polling = true
    task.spawn(function()
        warn("[VesselUse] Polling loop started")
        while true do
            local backpack = player:FindFirstChildOfClass("Backpack")
            if backpack then
                for _, child in ipairs(backpack:GetChildren()) do
                    if child:IsA("Tool") and not trackedTools[child] then
                        hookTool(child)
                    end
                end
            end
            local character = player.Character
            if character then
                for _, child in ipairs(character:GetChildren()) do
                    if child:IsA("Tool") and not trackedTools[child] then
                        hookTool(child)
                    end
                end
            end
            task.wait(1)
        end
    end)
end

local function trackCharacter(character)
    disconnectAll()
    bindUi()
    warn("[VesselUse] Tracking character", character and character:GetFullName())
    for _, child in ipairs((character and character:GetChildren()) or {}) do
        if child:IsA("Tool") then
            hookTool(child)
        end
    end
    if character then
        table.insert(activeConnections, character.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then
                hookTool(child)
            end
        end))
    end
    local backpack = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack", 5)
    trackBackpack(backpack)
    pollTools()
end

player.CharacterAdded:Connect(trackCharacter)
if player.Character then
    trackCharacter(player.Character)
end

playerGui.ChildAdded:Connect(function(child)
    if child.Name == "IngameScreenGui" then
        task.defer(bindUi)
    end
end)

resultEvent.OnClientEvent:Connect(function(payload)
    if payload and payload.message then
        fadeMessage(payload.message)
    end
end)
warn("[VesselUse] client script loaded")
